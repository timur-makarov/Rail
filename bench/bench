#!/usr/bin/env python3
"""The bench's launcher: bench/bench VERB ... from anywhere."""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("the bench needs Python 3.11 or newer\n")
    sys.exit(2)
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from bench.cli import main  # noqa: E402

sys.exit(main())
